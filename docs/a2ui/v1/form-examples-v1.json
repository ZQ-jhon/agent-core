              "type": "setVisible",
              "targetComponentId": "linked-company",
              "value": false
            },
            {
              "type": "setDisabled",
              "targetComponentId": "linked-company",
              "value": true
            },
            {
              "type": "setValue",
              "targetDataPath": "/identity/companyName",
              "value": null
            }
