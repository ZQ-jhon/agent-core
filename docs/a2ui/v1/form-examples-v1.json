        {
          "id": "show-contractor-company",
          "event": "change",
          "sourceDataPath": "/identity/personType",
          "when": {
            "op": "equals",
            "path": "/identity/personType",
            "value": "contractor"
          },
          "then": [
            {
              "type": "setVisible",
              "targetComponentId": "linked-company",
