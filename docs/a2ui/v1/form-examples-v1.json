              "type": "setVisible",
              "targetComponentId": "linked-company",
              "value": false
            },
            {
              "type": "setDisabled",
              "targetComponentId": "linked-company",
              "value": true
            },
            {
              "type": "setValue",
              "targetDataPath": "/identity/companyName",
              "value": null
            }
          ]
        }
      ],
      "meta": { "locale": "zh-CN", "title": "条件化资料补全示例" }
