# ============================================================
# API 配置 — 所有兼容 OpenAI 接口的供应商都能用
# ============================================================
#
# 选择一个供应商，取消注释并填写即可：
#
# --- OpenAI 官方 ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
#
# --- DeepSeek（性价比高，中文好）---
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# --- OpenRouter（聚合平台，一个 key 调所有模型）---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o
#
# --- Groq（速度快，LPU 推理）---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-70b-versatile
#
# --- Together AI（开源模型托管）---
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Llama-3.1-70B-Instruct
#
# --- Ollama 本地（免费，数据不出本机）---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
#
# --- 通义千问（阿里云）---
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
#
# --- 智谱 GLM ---
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4
#
# --- Moonshot（长上下文）---
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k
#
# --- 硅基流动（国内聚合）---
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# ============================================================
OPENAI_API_KEY=sk-your-key-here

# ============================================================
# A2UI form-submission persistence (development only)
# ============================================================
# SQLite is the local default. Production must provide a PostgreSQL repository
# implementation and host-authenticated principals; see docs/a2ui/v1/submission-persistence.md.
A2UI_DATABASE_URL=sqlite:///./.a2ui/a2ui-submissions.db
# The optional HTTP router is mounted by the host.  Authentication and form
# authorization are supplied through its trusted host ports, never from env.
